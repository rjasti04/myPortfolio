# ===========================================================================
# rjWebApp - Local Backend Environment Configuration Template
# Copy this file to '.env' and populate the values for local development.
# ===========================================================================

# ---------------------------------------------------------------------------
# Required Configurations
# ---------------------------------------------------------------------------

# PostgreSQL database connection string used by asyncpg (driver MUST be postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rjwebapp

# AWS region name where Amazon Bedrock client resides
AWS_REGION=us-east-1

# Default Amazon Bedrock model ID used for chat streams (e.g. Claude 3.5 Sonnet v2)
DEFAULT_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ---------------------------------------------------------------------------
# Optional Configurations (Uncomment and customize as needed)
# ---------------------------------------------------------------------------

# Set to true during test runs to disable rate limiting and skip strict checks
# TESTING=false

# Set to true to enable the background activity event simulator when Kafka is unavailable
# ENABLE_EVENT_SIMULATOR=false

# --- Activity ingest pipeline ---------------------------------------------
# Kafka consumer for the activity stream. Leave KAFKA_BOOTSTRAP_SERVERS empty
# to run without a broker: the consumer falls back to the simulator above, and
# the dashboard reports the Kafka stage as "bypass" rather than inventing a
# queue depth. Browser events reach PostgreSQL via /events/bulk either way.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=session-activity

# Rows buffered before an eager flush, and the periodic flush interval (s).
# The flusher is what writes any batch smaller than KAFKA_BATCH_SIZE.
# KAFKA_BATCH_SIZE=10
# KAFKA_BATCH_TIMEOUT=3.0

# Server-sent events tuning for the /sessions/{id}/stream dashboard feed.
# SSE_QUEUE_MAXSIZE bounds each listener's backlog (oldest frame dropped when
# full); SSE_REPLAY_BUFFER/SSE_REPLAY_TTL size the Last-Event-ID resume tail.
# SSE_QUEUE_MAXSIZE=100
# SSE_REPLAY_BUFFER=200
# SSE_REPLAY_TTL=300

# Log level for application output (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Comma-separated list of additional Bedrock foundation model IDs allowed by /chat
# ALLOWED_MODEL_IDS=us.anthropic.claude-3-5-haiku-20241022-v1:0,anthropic.claude-3-haiku-20240307-v1:0

# Comma-separated list of allowed CORS origins for FastAPI. Production endpoints are added automatically.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Comma-separated list of trusted proxy IPs/CIDR blocks to extract real IPs from X-Forwarded-For headers
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8

# Maximum size of incoming request body in bytes (default: 1048576 = 1 MB)
# MAX_BODY_BYTES=1048576

# Maximum concurrent Bedrock chat streams (default: 4)
# CHAT_MAX_CONCURRENCY=4

# Bedrock client read timeout in seconds (default: 30)
# BEDROCK_TIMEOUT_SECONDS=30

# Cross-instance SSE fan-out via Postgres LISTEN/NOTIFY. Only needed when more
# than one API process serves the same clients - a single instance already
# fans out in memory, and enabling this there is pure overhead.
# ENABLE_PG_FANOUT=false
# PG_FANOUT_CHANNEL=activity_events
