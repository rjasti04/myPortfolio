node_modules/
__pycache__/
*.pyc

# Virtualenvs. Not tracked (venv writes its own .venv/.gitignore), but listing
# them here keeps ripgrep-backed tooling and `find`/`grep -r` from walking
# ~7,500 dependency files that outnumber the 147 tracked files 50:1.
.venv/
server/.venv/

# Local environment secret variables
# AGENTS.md §6 instructs developers to create a root .env containing credentials (e.g. JWT_SECRET).
# Every variant, not only `.env` and `.env.local` - the deploy's rsync already
# excludes `.env*`, which says other variants exist. The example is the one
# tracked file with the prefix.
.env*
!.env.example

# Key material. The deploy writes an SSH key to disk; nothing like it belongs here.
*.pem
*.key
id_rsa*
id_ed25519*

# Test/tooling caches
.pytest_cache/

# Coverage artefact: a binary that every local pytest run rewrites, so it showed
# up as a spurious modification in unrelated commits.
.coverage
.venv-test/

# Build output. Generated by `npm run build`; the deploy builds it in CI.
dist/
