{
  "name": "rjwebapp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint frontend/js/*.js",
    "lint:css": "stylelint \"frontend/**/*.css\"",
    "format": "prettier --write \"**/*.{html,css,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md,yml,yaml}\"",
    "test": "node --test frontend/tests/*.test.js",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^38.0.0",
    "jsdom": "^26.1.0"
  }
}
