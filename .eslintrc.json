{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "globals": {
    "DOMPurify": "readonly",
    "marked": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "frontend/sw.js"
      ],
      "env": {
        "serviceworker": true,
        "browser": false
      }
    }
  ]
}
