{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(!**/.env.example)",
      "Edit(./.claude/templates/**)",
      "Read(./package-lock.json)",
      "Edit(./package-lock.json)",
      "Read(./server/.venv/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "Installing frontend and backend dependencies"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-migrations.sh",
            "timeout": 15,
            "statusMessage": "Verifying migration immutability"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-spa-egress.sh",
            "timeout": 15,
            "statusMessage": "Verifying SPA external asset egress allowlist"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-bash-writes.py",
            "timeout": 15,
            "statusMessage": "Verifying shell writes against migration, template, secret and egress rules"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/readonly-bash.py",
            "timeout": 15,
            "statusMessage": "Holding read-only subagents to read-only commands"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-csp.sh",
            "timeout": 30,
            "statusMessage": "Verifying CSP inline-script hashes"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-docs.sh",
            "timeout": 60,
            "statusMessage": "Verifying documented counts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-bash-edits.py",
            "timeout": 60,
            "statusMessage": "Verifying CSP hashes and documented counts after shell edits"
          }
        ]
      }
    ]
  }
}
