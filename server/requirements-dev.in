# Test dependencies. Includes the runtime set so both are resolved together and
# CI can never install a different version of a shared package than production.
#
#   uv pip compile server/requirements-dev.in --universal \
#     --python-version 3.10 --generate-hashes \
#     -o server/requirements-dev.txt
#
# CI installs requirements-dev.txt only; the host installs requirements.txt only.

-r requirements.in

