# Canonical URLs
#
# One hostname and one address per page. Requires AllowOverride FileInfo on
# the document root — the same grant the mod_headers block below already
# depends on. `curl -sI https://rjasti.com/ucl` must answer 200 with the
# no-store Cache-Control set at the bottom of this file; if it 404s, the
# override is off and these rules need to move into the vhost.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Extensionless addresses. THE_REQUEST is the raw request line, so these
  #    match only what the browser actually asked for and never the internal
  #    rewrite in rule 3 — no redirect loop. The target is absolute so a
  #    request to www.rjasti.com/ucl.html lands at rjasti.com/ucl in one hop
  #    instead of chaining through rule 2. mod_rewrite re-appends the original
  #    query string, so a ?s= share code survives the redirect.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ https://rjasti.com/ [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ https://rjasti.com/%1 [R=301,L]

  # 2. Apex host. sitemap.xml, robots.txt and the canonical tags all name
  #    rjasti.com; without this, www serves a duplicate of every page and
  #    ucl.html's share links inherit whichever host the visitor arrived on.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://rjasti.com%{REQUEST_URI} [R=301,L]

  # 3. Serve /ucl from ucl.html without changing the address bar. Guarded on
  #    the file existing, so /api and every real asset fall straight through.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Alias /regex to /cron#regex
  RewriteRule ^regex/?$ /cron#regex [R=301,NE,L]

  # 5. Alias /encode to /crypto#encoders
  RewriteRule ^encode/?$ /crypto#encoders [R=301,NE,L]

  # 6. Alias /yaml to /json#convert
  RewriteRule ^yaml/?$ /json#convert [R=301,NE,L]

  # 7. Alias /jsonpath to /json#query
  RewriteRule ^jsonpath/?$ /json#query [R=301,NE,L]

  # 8. Alias /patch to /diff#patch
  RewriteRule ^patch/?$ /diff#patch [R=301,NE,L]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/manifest+json
</IfModule>

# Enable Brotli Compression (if available)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/manifest+json
</IfModule>

# Cache-Control Headers
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  
  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  
  # HTML
  ExpiresByType text/html "access plus 0 seconds"
  
  # Manifest and metadata
  ExpiresByType application/manifest+json "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType application/pdf "access plus 1 hour"
  ExpiresByType application/octet-stream "access plus 1 hour"
</IfModule>

# `manifest.json` is the PWA manifest; make its media type explicit because
# Apache's stock mime.types normally serves .json as application/json.
<IfModule mod_mime.c>
  AddType application/manifest+json .json
</IfModule>

# Security Headers
#
# `always`, so they ride on Apache's own 4xx/5xx pages too - plain `set` only
# applies to successful responses. X-XSS-Protection is "0": the browser XSS
# auditor it switched on is gone from every current browser, and where it
# lingered `mode=block` could itself be abused to blank a page; current
# guidance is to disable it and rely on the CSP. Permissions-Policy denies the
# device APIs nothing here uses, keeping the microphone for the chat's voice
# input (chat.js, SpeechRecognition).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "0"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
  
  # Un-hashed static assets must revalidate. This is deliberately broader than
  # the fingerprinted rule below so a stable URL can never receive a year of
  # immutable freshness after its bytes change.
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|pdf)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # JSON/XML/TXT/sourcemaps and other metadata are not fingerprinted. Keep a
  # modest freshness window and require revalidation instead of heuristics.
  <FilesMatch "\.(json|xml|txt|map)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Un-hashed CSS/JS keeps revalidating.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Build output is content-hashed (main-7SKJSAC6.js), so the filename changes
  # whenever the bytes do and the old URL is never requested again. That makes
  # it safe to cache forever, which is the point of hashing.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Service workers must update promptly to refresh the PWA cache manifest
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  
  # No cache for HTML
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
